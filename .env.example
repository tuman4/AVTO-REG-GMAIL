# ═══════════════════════════════════════════════════════════════
#   GMAIL INFINITY — environment configuration
#   Copy to .env and fill in your real keys. Never commit .env.
# ═══════════════════════════════════════════════════════════════

# ── Engine ──────────────────────────────────────────────────────
# playwright = recommended. appium = Android golden method. selenium = legacy.
ENGINE_MODE=playwright
HEADLESS_MODE=False
BROWSER_TIMEOUT=30

# Playwright driver: "patchright" (default, patched — closes the
# Runtime.enable CDP leak that every major anti-bot fingerprints) or
# "playwright" (vanilla). Patchright needs:
#   pip install patchright && patchright install chromium
PLAYWRIGHT_DRIVER=patchright

# ── Account identity ────────────────────────────────────────────
# Leave YOUR_PASSWORD empty to generate a unique strong password per account.
YOUR_PASSWORD=
YOUR_BIRTHDAY=2 4 1990
YOUR_GENDER=1
RECOVERY_EMAIL=

# ── Proxy ───────────────────────────────────────────────────────
# One proxy per line in config/proxies.txt:
#   host:port | host:port:user:pass | user:pass@host:port | socks5://host:port
ENABLE_PROXY=True
DELAY_BETWEEN_ACCOUNTS=45

# Mobile proxies only: the provider's rotation URL, hit to get a fresh IP.
MOBILE_PROXY_IP_CHANGE_URL=
PROXY_CHANGE_WAIT_TIME=10

# ── SMS verification (premium mode) ─────────────────────────────
# 5sim uses names ("usa"); SMS-Activate/OnlineSIM use numeric codes
# (US = 187 / 1). Russia (0/7) is mass-banned by Google — avoid.
FIVESIM_API_KEY=
FIVESIM_COUNTRY=canada
# "any" = auto-pick the operator with the best cost-per-delivered-code from
# 5sim's public price feed (no key needed; 1h cache). Set to a named operator
# to pin it instead.
FIVESIM_OPERATOR=any
# Ceiling for auto-selection: operators priced above this are never chosen.
FIVESIM_MAX_PRICE=0.50
SMS_ACTIVATE_API_KEY=
SMS_ACTIVATE_COUNTRY=187
ONLINESIM_API_KEY=
ONLINESIM_COUNTRY=1
GETSMS_API_KEY=
GETSMS_COUNTRY=us

# ── CAPTCHA ─────────────────────────────────────────────────────
TWOCAPTCHA_API_KEY=
ANTICAPTCHA_API_KEY=
CAPMONSTER_API_KEY=

# ── Stealth modules ─────────────────────────────────────────────
# Session warming, fingerprint masking and human typing errors are always-on.
# The JS injection modules are opt-in: confirm a clean run works first, then
# enable one at a time.
ENABLE_POLTERGEIST=False
ENABLE_GHOST_TYPER=False
ENABLE_MAC_ROTATION=True

# ── Logging ─────────────────────────────────────────────────────
ENABLE_LOGGING=True
LOG_FILE=data/gmail_creator.log
LOG_LEVEL=INFO

# ── Voice OTP server (optional) ────────────────────────────────
# REQUIRED: without a token the server refuses to start.
VOICE_SERVER_TOKEN=

# ── Telegram notifications (optional) ───────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
